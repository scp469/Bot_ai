{
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "command": "python .antigravity/hooks/protect_env.py"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "command": "python .antigravity/hooks/run_related_tests.py"
      },
      {
        "matcher": "Edit|Write",
        "command": "python .antigravity/hooks/format_python.py"
      }
    ]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "BASH_MAX_OUTPUT_LENGTH": "100000"
  }
}