# Chaos Zero Nightmare Bot Configuration (.env)
# Rename this file to .env and fill in your values. DO NOT commit .env to version control!
# Bot hoạt động 100% ngoại tuyến (heuristic/template matching/OCR rules), không cần API Key AI.

# ── ADB & Device ─────────────────────────────────────────────
ADB_HOST=127.0.0.1
ADB_PORT=5555
# ADB_PATH=C:\Program Files\BlueStacks_nxt\HD-Adb.exe

# ── Notifications ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ENABLE_WINDOWS_TOAST=true

# ── AI Vision & Gemini API ────────────────────────────────────
GEMINI_API_KEY=

# ── Feature Flags & Tuning ───────────────────────────────────
ENABLE_HYBRID_VERIFICATION=true
ENABLE_DYNAMIC_ISLAND_DETECTION=true
AUTO_PICK_EPIPHANY=true
